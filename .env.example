# code-insight-engine reads these optional environment variables at
# startup. None are required — the tool works with sane defaults if unset.

# Emit structured JSON logs instead of human-readable colored text.
CODE_INSIGHT_LOG_JSON=0

# If set, additionally write logs to this file path via a rotating handler.
CODE_INSIGHT_LOG_FILE=

# Max bytes per log file before rotation. Default: 5242880 (5 MiB).
CODE_INSIGHT_LOG_FILE_MAX_BYTES=5242880
